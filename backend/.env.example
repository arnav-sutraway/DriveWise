# Copy this file to backend/.env and fill in your key. Never commit .env.
# Free key: https://aistudio.google.com/apikey
# Out of free Gemini requests? Test locally with Claude Code instead: see .env.local.example.
GEMINI_API_KEY=

# Optional overrides
# Comma-separated HTTPS host allowlist for `manage.py ingest_url`.
# Example: KNOWLEDGE_ALLOWED_HOSTS=dds.georgia.gov
KNOWLEDGE_ALLOWED_HOSTS=
# RAG_CHAT_MODEL=gemini-3.1-flash-lite
# RAG_EMBEDDING_MODEL=gemini-embedding-001
# RAG_TOP_K=5
# RAG_MIN_SCORE=0.55

# Performance warnings: 0 = disabled while collecting a baseline.
# Set these to your agreed response-time and error-rate targets.
# PERFORMANCE_LATENCY_WARNING_MS=0
# PERFORMANCE_FAILURE_WARNING_PERCENT=0

# --- Deployment (PythonAnywhere) ---
# DJANGO_SECRET_KEY=<long random string>
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=<username>.pythonanywhere.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://<username>.pythonanywhere.com

# Chat questions per visitor per window (0 = no limit).
# CHAT_RATE_LIMIT=10
# CHAT_RATE_LIMIT_WINDOW_SECONDS=60
