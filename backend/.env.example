# Copy this file to backend/.env and fill in your key. Never commit .env.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
# RAG_CHAT_MODEL=gemini-3.1-flash-lite
# RAG_EMBEDDING_MODEL=gemini-embedding-001
# RAG_TOP_K=5
# RAG_MIN_SCORE=0.55

# Performance warnings: 0 = disabled while collecting a baseline.
# Set these to your agreed response-time and error-rate targets.
# PERFORMANCE_LATENCY_WARNING_MS=0
# PERFORMANCE_FAILURE_WARNING_PERCENT=0
