# Local-testing profile: uses no Gemini quota and needs no API key.
# - Answers come from your own Claude Code login, run as `claude -p` with all tools disabled.
# - Passages are found with the offline hashing embedder (keyword overlap; rougher than Gemini).
# - Everything lives in a separate database, so it never mixes with your Gemini-embedded one.
#
# Setup (PowerShell, from backend/), once:
#   Copy-Item .env.local.example .env.local
#   $env:DRIVEWISE_ENV_FILE = ".env.local"
#   python manage.py migrate
#   python manage.py ingest_documents --state Georgia
# Then, in any terminal where you want local testing:
#   $env:DRIVEWISE_ENV_FILE = ".env.local"
#   python manage.py runserver
# Back to Gemini (or just open a new terminal):
#   Remove-Item Env:DRIVEWISE_ENV_FILE

RAG_LLM=claude_code
RAG_EMBEDDER=hashing
SQLITE_PATH=db.local.sqlite3

# Hashing scores run lower than Gemini's (a four-way-stop question peaks around 0.2), so the
# cutoff is lower too. Hashing can't tell off-topic questions apart by score; the prompt's
# NO_ANSWER rule is what makes the coach decline those.
RAG_MIN_SCORE=0.15

# Model alias or ID passed to `claude --model`; blank uses your Claude Code default.
CLAUDE_CODE_MODEL=haiku
# CLAUDE_CODE_BIN=claude
# CLAUDE_CODE_TIMEOUT_SECONDS=120

# No per-visitor chat limit while testing locally.
CHAT_RATE_LIMIT=0
